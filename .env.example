REGFOX_API_KEY=your_api_key_here
REGFOX_EVENT_ID=your_test_event_id_here

# Optional local scanner server (disabled by default)
# SCANNER_SERVER_ENABLED=true
# SCANNER_SERVER_PORT=3847

# Packaged FoxBridge Cloud public defaults (non-secret). Empty in the open repo;
# set at packaging/CI / local packaging builds. Never put a service-role here.
# See docs/FOXBRIDGE_SYNC_DEPLOYMENT.md (Sprint 21.9) for production order.
# FOXBRIDGE_CLOUD_URL=https://your-project.supabase.co
# FOXBRIDGE_CLOUD_PUBLISHABLE_KEY=your_anon_or_publishable_key
# FOXBRIDGE_CLOUD_ANON_KEY=your_anon_key  # alias for FOXBRIDGE_CLOUD_PUBLISHABLE_KEY
# FOXBRIDGE_SCANNER_URL=https://scanner.your-conference.example.com

# Optional legacy / local-dev FoxBridge Cloud (Supabase implementation)
# Prefer FOXBRIDGE_CLOUD_* for public config. Service role is local-only — never
# ship it in distributed desktop builds.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_CONFERENCE_ID=your_conference_uuid  # optional; auto-created on first publish

# Mobile PWA URL shown to volunteers (hosted production address)
# MOBILE_APP_URL=https://scanner.your-conference.example.com
